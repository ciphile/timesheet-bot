# Token bot Telegram do @BotFather dua (dang 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=chua_co

# So chat_id cua ban (nhan tin cho @userinfobot tren Telegram de lay)
TELEGRAM_ALLOWED_CHAT_ID=chua_co

# (TUY CHON) Gmail ca nhan - CHI CAN neu muon gui du phong bang Gmail (/personalmailon).
# Khong dung thi DE NGUYEN chua_co: bot luon gui bang mail cong ty, khong bao loi.
GMAIL_ADDRESS=chua_co

# (TUY CHON) App Password 16 ky tu cua Gmail (bo het khoang trang khi dan)
GMAIL_APP_PASSWORD=chua_co

# API key Gemini (lay o aistudio.google.com/apikey, dang AIza... hoac AQ.)
GEMINI_API_KEY=chua_co

# Mat khau email CONG TY (de gui timesheet bang mail cong ty)
COMPANY_MAIL_PASSWORD=chua_co
